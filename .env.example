# Servidor
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# No Coolify, monte armazenamento persistente neste caminho.
APP_DATA_DIR=/data

# Omitir estas variaveis usa subpastas de APP_DATA_DIR.
WHATSAPP_SESSION_DIR=/data/wpp_session
MELI_PROFILE_DIR=/data/ml_user_data

# Arquivos temporarios de execucao e diagnostico.
APP_RUNTIME_DIR=/data/runtime

# Permite iniciar somente o painel, sem abrir o WhatsApp Web.
WHATSAPP_ENABLED=true
WHATSAPP_GROUP_NAME=Alerta de Descontos
# Prefira o ID fixo do grupo em producao, por exemplo: 120363000000000000@g.us
WHATSAPP_GROUP_ID=
WHATSAPP_AUTH_TIMEOUT_MS=120000
WHATSAPP_PROTOCOL_TIMEOUT_MS=180000
WHATSAPP_PROFILE_LOCK_GRACE_MS=90000
WHATSAPP_RECONNECT_DELAY_MS=15000
WHATSAPP_MAX_RECONNECT_DELAY_MS=300000
WHATSAPP_DELETE_ON_REACTION=true

# Caminho opcional do Chrome/Chromium.
# BROWSER_EXECUTABLE_PATH=/usr/bin/google-chrome

# Coleta independente das publicacoes.
DEALS_REFRESH_ENABLED=true
DEALS_REFRESH_INTERVAL_MINUTES=30
DEALS_STALE_AFTER_MINUTES=90

# Feed Shopee: o ciclo acima verifica o ETag e so baixa quando o CSV mudar.
# Separe por virgula quando a Shopee fornecer mais de um arquivo.
SHOPEE_FEED_ENABLED=true
SHOPEE_STALE_AFTER_MINUTES=1560
SHOPEE_OFFICIAL_FEED_URLS=
SHOPEE_GENERAL_FEED_URLS=
SHOPEE_MIN_DISCOUNT=30
SHOPEE_MAX_DISCOUNT=80
SHOPEE_MIN_ITEM_RATING=4.5
SHOPEE_MIN_SHOP_RATING=4.5
SHOPEE_MAX_PRODUCTS=400
SHOPEE_INCLUDE_CROSS_BORDER=false

# 15 ofertas/h podem consumir 360 ofertas unicas por dia.
MIN_DISCOUNT=20
MAX_PRODUCTS=400
ML_MAX_PAGES=15

# Ative somente depois de validar o grupo e a sessao persistente.
AUTO_RUN_ENABLED=false
WPP_POSTS_PER_HOUR=15

# Pesquisa manual e comparacao sob demanda nos cards.
# O mesmo cache de 30 minutos atende os dois recursos.
MARKETPLACE_SEARCH_ENABLED=true
MARKETPLACE_SEARCH_CACHE_MINUTES=30
MARKETPLACE_SEARCH_RESULTS_PER_SITE=4

# Fila assistida para preparar Stories. Nao gera links afiliados nem publica
# no Instagram. Defina false para esconder e desativar todo o recurso.
PUBLICATION_QUEUE_ENABLED=true

# Worker local opcional para gerar links com a sessao do Mercado Livre no
# Chrome/Edge. Use um segredo longo e igual nas opcoes da extensao.
LOCAL_AFFILIATE_WORKER_ENABLED=false
LOCAL_AFFILIATE_WORKER_TOKEN=
LOCAL_AFFILIATE_CLAIM_MINUTES=5
LOCAL_AFFILIATE_MAX_ATTEMPTS=3
